# Local server defaults to port 43128; Vite proxies requests from 43127.
PORT=43128
AUTH_MODE=local
# On Railway: AUTH_MODE=disabled for the initial URL-only deployment.
# After registering the LagosLife draft, use AUTH_MODE=vatar and configure:
# DATABASE_URL=postgresql://...
# VATAR_GAME_ID=your-game-id
# VATAR_SECRET=your-test-secret-from-LagosLife
# PUBLIC_ORIGIN=https://your-game-domain
# Never set AUTH_MODE=local on a public deployment.
